generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phone           String?  @unique
  username        String   @unique
  password        String
  displayName     String
  walletBalance   Float    @default(0)
  stripeCustomerId String?
  tosAccepted     Boolean  @default(false)
  tosAcceptedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  beefs Created     Beef[]  @relation("BeefCreator")
  beefsAccepted    Beef[]  @relation("BeefChallenger")
  beefsWon         Beef[]  @relation("BeefWinner")
  posts            Post[]
  likes            Like[]
  transactions     Transaction[]
}

enum BeefStatus {
  OPEN        // Waiting for challenger
  ACTIVE      // Debate in progress
  COMPLETED   // Settled
  CONCEDED    // One party conceded
  WITHDRAWN   // Creator withdrew before acceptance
}

enum SettlementType {
  WEB_ANALYSIS
  CROWD_VOTE
  CONCESSION
  DRAW
}

model Beef {
  id                String         @id @default(uuid())
  topic             String         @db.Text
  ante              Float          // Max $1000
  status            BeefStatus     @default(OPEN)
  creatorPosition   String         @db.Text
  challengerPosition String?       @db.Text
  
  creatorId         String
  creator           User           @relation("BeefCreator", fields: [creatorId], references: [id])
  
  challengerId      String?
  challenger        User?          @relation("BeefChallenger", fields: [challengerId], references: [id])
  
  winnerId          String?
  winner            User?          @relation("BeefWinner", fields: [winnerId], references: [id])
  
  settlementType    SettlementType?
  webAnalysisResult Json?
  
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  // Relations
  posts             Post[]
  likes             Like[]
  transactions      Transaction[]
}

model Post {
  id        String   @id @default(uuid())
  content   String   @db.Text // Max 500 words
  wordCount Int
  createdAt DateTime @default(now())
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  
  beefId    String
  beef      Beef     @relation(fields: [beefId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  isLike    Boolean  // true = like, false = dislike
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  beefId    String
  beef      Beef     @relation(fields: [beefId], references: [id], onDelete: Cascade)
  
  @@unique([userId, beefId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_HOLD      // Ante placed into escrow
  ESCROW_RELEASE   // Winner receives payout
  ESCROW_RETURN    // Returned if beef withdrawn
  PLATFORM_FEE     // 1% service fee
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Float
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())
  
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  
  beefId      String?
  beef        Beef?           @relation(fields: [beefId], references: [id], onDelete: SetNull)
  
  stripePaymentId String?
}
